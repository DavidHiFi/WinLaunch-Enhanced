<Window x:Class="WinLaunch.Enhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinLaunch.Enhanced.Views"
        Title="WinLaunch Enhanced"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource ScrimBrush}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized">
  <views:SpringboardView x:Name="Board" AllowDrop="True"/>
</Window>
