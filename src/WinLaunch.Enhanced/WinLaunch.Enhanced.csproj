<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinLaunchEnhanced</AssemblyName>
    <RootNamespace>WinLaunch.Enhanced</RootNamespace>
    <Version>2.4.1</Version>
    <Product>WinLaunch Enhanced</Product>
    <AssemblyTitle>WinLaunch Enhanced</AssemblyTitle>
    <Description>A fast, modern Launchpad-style app launcher for Windows</Description>
    <Company>DavidHiFi</Company>
    <Copyright>Copyright (C) 2022 MrC0rrupted, 2026 DavidHiFi. MIT license.</Copyright>
    <ApplicationIcon>Assets\WinLaunchEnhanced.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-256.png" />
    <Resource Include="Assets\WinLaunchEnhanced.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinLaunch.Legacy\WinLaunch.Legacy.csproj" />
  </ItemGroup>

</Project>
