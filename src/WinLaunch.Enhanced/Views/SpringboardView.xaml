<UserControl x:Class="WinLaunch.Enhanced.Views.SpringboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinLaunch.Enhanced.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Focusable="True" FontFamily="{DynamicResource UiFont}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Sizes are recomputed from the screen, the grid and the user's icon
         size whenever the page area resizes (see UpdateTileMetrics). -->
    <sys:Int32 x:Key="PageColumns">10</sys:Int32>
    <sys:Int32 x:Key="PageRows">5</sys:Int32>
    <sys:Double x:Key="TileCellWidth">180</sys:Double>
    <sys:Double x:Key="TileCellHeight">180</sys:Double>
    <sys:Double x:Key="TileIconSize">104</sys:Double>
    <sys:Double x:Key="TileLabelWidth">160</sys:Double>
    <sys:Double x:Key="TileFontSize">14</sys:Double>
    <sys:Double x:Key="TileLabelMaxHeight">40</sys:Double>
    <Visibility x:Key="ItemLabelVisibility">Visible</Visibility>
    <Visibility x:Key="FolderLabelVisibility">Visible</Visibility>

    <!-- Remove badge shown on every tile while the layout is being edited. -->
    <Style x:Key="DeleteBadge" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="-8,-8,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Disc" Fill="{DynamicResource DeleteBadgeBrush}"
                       Stroke="#CCFFFFFF" StrokeThickness="1.5">
                <Ellipse.Effect>
                  <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.5" Color="Black"/>
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="9" Foreground="White" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource WarnBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource TileFontSize}"/>
      <Setter Property="MaxWidth" Value="{DynamicResource TileLabelWidth}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="MaxHeight" Value="{DynamicResource TileLabelMaxHeight}"/>
      <Setter Property="Height" Value="{DynamicResource TileLabelMaxHeight}"/>
      <Setter Property="Margin" Value="0,9,0,0"/>
      <Setter Property="Effect" Value="{DynamicResource LabelEffect}"/>
    </Style>

    <DataTemplate x:Key="AppTileTemplate">
      <Button Style="{DynamicResource TileButton}"
              Width="{DynamicResource TileCellWidth}" Height="{DynamicResource TileCellHeight}"
              Click="Tile_Click" Tag="{Binding}" ToolTip="{Binding Tooltip}"
              ToolTipService.InitialShowDelay="900"
              PreviewMouseLeftButtonDown="Tile_PreviewMouseDown"
              PreviewMouseLeftButtonUp="Tile_PreviewMouseUp"
              PreviewMouseMove="Tile_MouseMove" MouseEnter="Tile_MouseEnter"
              ContextMenuOpening="Tile_ContextMenuOpening">
        <Button.ContextMenu>
          <ContextMenu/>
        </Button.ContextMenu>
        <Grid x:Name="WiggleHost" Loaded="WiggleHost_Loaded" Unloaded="WiggleHost_Unloaded"
              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
          <Grid.RenderTransform>
            <RotateTransform/>
          </Grid.RenderTransform>
          <StackPanel>
            <Grid Width="{DynamicResource TileIconSize}" Height="{DynamicResource TileIconSize}">
              <Image x:Name="TileIcon" Source="{Binding Icon}"
                     RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                  <DropShadowEffect ShadowDepth="3" BlurRadius="12" Opacity="0.35" Color="Black"/>
                </Image.Effect>
              </Image>
              <Button Style="{StaticResource DeleteBadge}" Tag="{Binding}" Click="Badge_Click"
                      Visibility="{Binding DataContext.EditMode,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"
                       Visibility="{DynamicResource ItemLabelVisibility}"/>
          </StackPanel>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Broken}" Value="True">
          <Setter TargetName="TileIcon" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FolderTileTemplate">
      <Button Style="{DynamicResource TileButton}"
              Width="{DynamicResource TileCellWidth}" Height="{DynamicResource TileCellHeight}"
              Click="Tile_Click" Tag="{Binding}" ToolTip="{Binding Tooltip}"
              ToolTipService.InitialShowDelay="900"
              PreviewMouseLeftButtonDown="Tile_PreviewMouseDown"
              PreviewMouseLeftButtonUp="Tile_PreviewMouseUp"
              PreviewMouseMove="Tile_MouseMove" MouseEnter="Tile_MouseEnter"
              ContextMenuOpening="Tile_ContextMenuOpening">
        <Button.ContextMenu>
          <ContextMenu/>
        </Button.ContextMenu>
        <Grid x:Name="WiggleHost" Loaded="WiggleHost_Loaded" Unloaded="WiggleHost_Unloaded"
              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
          <Grid.RenderTransform>
            <RotateTransform/>
          </Grid.RenderTransform>
          <StackPanel>
            <Grid Width="{DynamicResource TileIconSize}" Height="{DynamicResource TileIconSize}">
              <!-- Glass folder with a 3x3 grid of its first apps, like the original. -->
              <Border x:Name="FolderGlass" Background="{DynamicResource FolderIconBrush}"
                      BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                      CornerRadius="24" Padding="11">
                <ItemsControl ItemsSource="{Binding PreviewChildren}" Focusable="False"
                              IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" Rows="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Image Source="{Binding Icon}" Margin="3"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Image x:Name="CustomIcon" Source="{Binding Icon}" Visibility="Collapsed"
                     RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                  <DropShadowEffect ShadowDepth="3" BlurRadius="12" Opacity="0.35" Color="Black"/>
                </Image.Effect>
              </Image>
              <Button Style="{StaticResource DeleteBadge}" Tag="{Binding}" Click="Badge_Click"
                      Visibility="{Binding DataContext.EditMode,
                        RelativeSource={RelativeSource AncestorType=UserControl},
                        Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Text="{Binding Name}" Style="{StaticResource TileLabel}"
                       Visibility="{DynamicResource FolderLabelVisibility}"/>
          </StackPanel>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
          <Setter TargetName="FolderGlass" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="CustomIcon" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <views:TileTemplateSelector x:Key="TileSelector"
        AppTemplate="{StaticResource AppTileTemplate}"
        FolderTemplate="{StaticResource FolderTileTemplate}"/>
  </UserControl.Resources>

  <Grid x:Name="Root" Background="#01000000"
        PreviewMouseLeftButtonDown="Root_PreviewMouseDown"
        PreviewMouseLeftButtonUp="Root_PreviewMouseUp"
        MouseLeftButtonUp="Root_MouseLeftButtonUp"
        MouseWheel="Root_MouseWheel"
        ContextMenuOpening="Root_ContextMenuOpening">
    <Grid.ContextMenu>
      <ContextMenu/>
    </Grid.ContextMenu>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar: centered search pill, quiet controls on the right. -->
    <Grid Grid.Row="0" Margin="28,30,28,8">
      <Border x:Name="SearchPill" Width="300" Height="36" CornerRadius="18"
              HorizontalAlignment="Center"
              BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <StackPanel x:Name="SearchHint" Orientation="Horizontal" HorizontalAlignment="Center"
                      VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="13" Foreground="{DynamicResource LabelBrush}"
                       VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Search" FontSize="14" Foreground="{DynamicResource LabelBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="SearchGlyph" Text="&#xE721;" Visibility="Collapsed"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                     Foreground="{DynamicResource LabelBrush}" Opacity="0.7"
                     VerticalAlignment="Center" Margin="14,1,0,0" IsHitTestVisible="False"/>
          <TextBox x:Name="SearchBox" Style="{DynamicResource SearchPill}" Margin="36,0,36,0"
                   TextChanged="SearchBox_TextChanged"
                   GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged"/>
        </Grid>
      </Border>
      <!-- Calculator: typing 12*7 shows the answer beside the search pill. -->
      <Border x:Name="CalcChip" Visibility="Collapsed" HorizontalAlignment="Center" Margin="470,0,0,0"
              Height="36" CornerRadius="18" Padding="16,0" Cursor="Hand"
              Background="{DynamicResource AccentBrush}" MouseLeftButtonUp="CalcChip_Click"
              ToolTip="Enter copies the result">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="=" FontSize="14" Foreground="{DynamicResource AccentInkBrush}" Opacity="0.7" Margin="0,0,8,0"/>
          <TextBlock x:Name="CalcText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="DoneButton" Content="Done" Style="{DynamicResource GlassPillButton}"
                Visibility="Collapsed" Click="Done_Click" Margin="0,0,10,0"/>
        <Button x:Name="MenuButton" Content="&#xE712;" Style="{DynamicResource GlassIconButton}"
                ToolTip="Menu" Click="MenuButton_Click"/>
      </StackPanel>
    </Grid>

    <!-- Pages -->
    <Grid x:Name="PageHost" Grid.Row="1" Margin="56,8,56,0" ClipToBounds="False"
          SizeChanged="PageHost_SizeChanged">
      <ItemsControl x:Name="TileGrid" ItemTemplateSelector="{StaticResource TileSelector}"
                    Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                    KeyboardNavigation.DirectionalNavigation="Contained">
        <ItemsControl.RenderTransform>
          <TranslateTransform x:Name="PageShift"/>
        </ItemsControl.RenderTransform>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{DynamicResource PageColumns}" Rows="{DynamicResource PageRows}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <TextBlock x:Name="LoadingState" Text="Loading your apps…" FontSize="16"
                 Foreground="{DynamicResource LabelBrush}" Opacity="0.7"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

      <StackPanel x:Name="NoResults" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock Text="No apps match" FontSize="22" TextAlignment="Center" Opacity="0.75"
                   Foreground="{DynamicResource LabelBrush}"/>
        <TextBlock Text="Esc clears the search" FontSize="13" TextAlignment="Center" Opacity="0.55"
                   Margin="0,10,0,0" Foreground="{DynamicResource LabelBrush}"/>
      </StackPanel>

      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock Text="Nothing pinned yet" FontSize="22" TextAlignment="Center"
                   Foreground="{DynamicResource LabelBrush}"/>
        <TextBlock Text="Drop shortcuts here or add apps from the menu." FontSize="14"
                   Margin="0,8,0,18" Opacity="0.7" TextAlignment="Center"
                   Foreground="{DynamicResource LabelBrush}"/>
        <Button Content="Add apps" HorizontalAlignment="Center" Click="Add_Click"
                Style="{DynamicResource GlassPillButton}"/>
      </StackPanel>

      <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock Text="Your apps could not be loaded" FontSize="22" TextAlignment="Center"
                   Foreground="{DynamicResource LabelBrush}"/>
        <TextBlock x:Name="ErrorDetail" FontSize="13" Margin="0,8,0,18" Opacity="0.75"
                   MaxWidth="620" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource LabelBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="Retry" Click="Retry_Click" Margin="0,0,10,0"
                  Style="{DynamicResource GlassPillButton}"/>
          <Button Content="Open data folder" Click="OpenData_Click"
                  Style="{DynamicResource GlassPillButton}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Page dots and the undo toast share the bottom strip. -->
    <Grid Grid.Row="2" Margin="0,8,0,28" MinHeight="40">
      <Button x:Name="AddButton" Content="&#xE710;" Style="{DynamicResource GlassIconButton}"
              ToolTip="Add apps, links or folders" HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="28,0,0,0" Click="AddButton_Click"/>
      <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
      <Border x:Name="UndoToast" Visibility="Collapsed" HorizontalAlignment="Center"
              VerticalAlignment="Center" CornerRadius="18" Padding="18,6,6,6"
              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="UndoText" FontSize="13" Foreground="{DynamicResource TextBrush}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Undo" Click="Undo_Click" Style="{DynamicResource PrimaryButton}"
                  Padding="14,5"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Open folder: dimmed board, editable title, glass band of apps. -->
    <Grid x:Name="FolderLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Rectangle x:Name="FolderDim" Fill="{DynamicResource DimBrush}"
                 MouseLeftButtonUp="FolderDim_MouseUp"/>
      <StackPanel x:Name="FolderPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
          <ScaleTransform x:Name="FolderScale" ScaleX="1" ScaleY="1"/>
        </StackPanel.RenderTransform>
        <TextBox x:Name="FolderTitle" HorizontalAlignment="Center" MinWidth="240"
                 TextAlignment="Center" FontSize="30" Background="Transparent"
                 BorderThickness="0" Foreground="{DynamicResource LabelBrush}"
                 CaretBrush="{DynamicResource LabelBrush}" FocusVisualStyle="{x:Null}"
                 KeyDown="FolderTitle_KeyDown" LostKeyboardFocus="FolderTitle_LostFocus">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Under" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Under" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
          <TextBox.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.8"
                              Color="{DynamicResource LabelShadowColor}"/>
          </TextBox.Effect>
        </TextBox>
        <Border x:Name="FolderBand" Margin="0,18,0,0" CornerRadius="30" Padding="24,18"
                Background="{DynamicResource FolderBandBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                ContextMenuOpening="FolderBand_ContextMenuOpening">
          <Border.ContextMenu>
            <ContextMenu/>
          </Border.ContextMenu>
          <Border.Resources>
            <SolidColorBrush x:Key="LabelBrush" Color="{DynamicResource TextColor}"/>
            <x:Null x:Key="LabelEffect"/>
          </Border.Resources>
          <ScrollViewer x:Name="FolderScroll" VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="FolderGrid" ItemTemplateSelector="{StaticResource TileSelector}"
                          Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Snapshot of the tile being dragged follows the pointer here. -->
    <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False"/>

    <!-- In-overlay Edit sheet: the original's Edit dialog (icon, name, path,
         arguments, keywords, notes, admin, miniatures) without leaving the overlay. -->
    <Grid x:Name="EditLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Rectangle Fill="{DynamicResource DimBrush}" MouseLeftButtonUp="EditCancel_Click"/>
      <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="16" Padding="24"
              TextElement.Foreground="{DynamicResource TextBrush}">
        <StackPanel>
          <TextBlock x:Name="EditTitle" FontSize="16" FontWeight="SemiBold"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="EditIconButton" Style="{DynamicResource TileButton}" Width="92" Height="92"
                    Padding="10" Click="EditChooseIcon_Click" ToolTip="Choose a new icon">
              <Image x:Name="EditIcon" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
              <TextBox x:Name="EditName" Style="{DynamicResource SearchBox}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Change icon…" Click="EditChooseIcon_Click" Margin="0,0,8,0" Padding="12,6"
                        Style="{DynamicResource SecondaryButton}"/>
                <Button x:Name="EditResetIcon" Content="Restore icon" Click="EditResetIcon_Click" Padding="12,6"
                        Style="{DynamicResource SecondaryButton}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="EditAppFields">
            <TextBlock Text="Path or web address" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="EditPath" Style="{DynamicResource SearchBox}"/>
              <Button Grid.Column="1" Content="File…" Click="EditBrowseFile_Click" Margin="8,0,0,0" Padding="12,6"
                      Style="{DynamicResource SecondaryButton}"/>
              <Button Grid.Column="2" Content="Folder…" Click="EditBrowseFolder_Click" Margin="8,0,0,0" Padding="12,6"
                      Style="{DynamicResource SecondaryButton}"/>
            </Grid>
            <TextBlock Text="Arguments" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="EditArgs" Style="{DynamicResource SearchBox}"/>
            <TextBlock Text="Search keywords" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="EditKeywords" Style="{DynamicResource SearchBox}"/>
          </StackPanel>
          <TextBlock Text="Notes (shown in the tooltip)" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
          <TextBox x:Name="EditNotes" Style="{DynamicResource SearchBox}"/>
          <CheckBox x:Name="EditAdmin" Content="Always run as administrator" Style="{DynamicResource ToggleRow}" Margin="0,10,0,0"/>
          <CheckBox x:Name="EditMiniatures" Content="Show app miniatures on the folder" Style="{DynamicResource ToggleRow}" Margin="0,10,0,0"/>
          <TextBlock x:Name="EditError" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap"
                     Margin="0,8,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="EditCancel_Click" Margin="0,0,8,0" MinWidth="88"
                    Style="{DynamicResource SecondaryButton}"/>
            <Button Content="Save" Click="EditSave_Click" MinWidth="88" IsDefault="False"
                    Style="{DynamicResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- In-overlay prompt for rename and new folder (no separate window, so
         the overlay never loses focus and hides mid-edit). -->
    <Grid x:Name="PromptLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Rectangle Fill="{DynamicResource DimBrush}" MouseLeftButtonUp="PromptCancel_Click"/>
      <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="16" Padding="22">
        <StackPanel>
          <TextBlock x:Name="PromptTitle" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="PromptMessage" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
          <TextBox x:Name="PromptBox" Style="{DynamicResource SearchBox}" Margin="0,14,0,0"
                   FontSize="14" KeyDown="PromptBox_KeyDown"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="PromptCancel" Content="Cancel" Click="PromptCancel_Click" Margin="0,0,8,0" MinWidth="88"
                    Style="{DynamicResource SecondaryButton}"/>
            <Button x:Name="PromptOk" Content="Save" Click="PromptOk_Click" MinWidth="88"
                    Style="{DynamicResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
