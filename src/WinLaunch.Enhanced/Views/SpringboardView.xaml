<UserControl x:Class="WinLaunch.Enhanced.Views.SpringboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
  <UserControl.Resources>
    <DataTemplate x:Key="TileTemplate">
      <Button Style="{DynamicResource TileButton}" Width="128" Height="128"
              HorizontalAlignment="Center" Margin="6"
              Click="Tile_Click" Tag="{Binding}"
              PreviewMouseLeftButtonDown="Tile_PreviewMouseDown"
              MouseMove="Tile_MouseMove" DragOver="Tile_DragOver" Drop="Tile_Drop" AllowDrop="True"
              ToolTip="{Binding ResolvedTarget}">
        <Button.ContextMenu>
          <ContextMenu Opened="TileMenu_Opened">
            <MenuItem Header="Open" Click="Menu_Open"/>
            <MenuItem Header="Rename" Click="Menu_Rename"/>
            <MenuItem Header="Delete" Click="Menu_Delete"/>
          </ContextMenu>
        </Button.ContextMenu>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="64" Height="64"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                     MaxWidth="112" MaxHeight="36" FontSize="12" Margin="0,6,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="48,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Width="420" HorizontalAlignment="Center" Margin="0,0,0,20">
      <TextBox x:Name="SearchBox" Style="{DynamicResource SearchBox}"
               TextChanged="SearchBox_TextChanged"/>
      <TextBlock x:Name="SearchHint" Text="Search apps and folders…"
                 Foreground="{DynamicResource MutedBrush}" FontSize="15"
                 Margin="14,9,0,0" IsHitTestVisible="False"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="TileGrid" ItemTemplate="{StaticResource TileTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid x:Name="PageGrid" Columns="10"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- Loading state -->
    <StackPanel x:Name="LoadingState" Grid.Row="1" HorizontalAlignment="Center"
                VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="Loading your pinned apps…" FontSize="16"
                 Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>

    <!-- Empty state -->
    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="Nothing pinned yet." FontSize="20"
                 Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
      <TextBlock Text="Drag apps here, or use Add below." FontSize="14" Margin="0,8,0,16"
                 Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
      <Button Content="Add apps" Width="140" Height="36" FontSize="13"
              Click="Add_Click" Style="{DynamicResource TileButton}"/>
    </StackPanel>

    <!-- Error state -->
    <StackPanel x:Name="ErrorState" Grid.Row="1" HorizontalAlignment="Center"
                VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="Something failed while loading." FontSize="20"
                 Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
      <TextBlock x:Name="ErrorDetail" Text="" FontSize="13" Margin="0,8,0,16"
                 Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                 MaxWidth="600" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Retry" Width="120" Click="Retry_Click" Margin="0,0,8,0"
                Style="{DynamicResource TileButton}" Height="36" FontSize="13"/>
        <Button Content="Open data folder" Width="150" Click="OpenData_Click"
                Style="{DynamicResource TileButton}" Height="36" FontSize="13"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,16,0,0">
      <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center"/>
      <Button Content="Add" Margin="16,0,0,0" Click="Add_Click" Padding="16,4"
              Style="{DynamicResource TileButton}" Height="34" FontSize="13"/>
      <Button Content="New folder" Margin="8,0,0,0" Click="NewFolder_Click" Padding="16,4"
              Style="{DynamicResource TileButton}" Height="34" FontSize="13"/>
      <Button x:Name="EditButton" Content="Edit" Margin="8,0,0,0"
              Click="EditToggle_Click" Padding="16,4"
              Style="{DynamicResource TileButton}" Height="34" FontSize="13"/>
      <Button Content="Settings" Margin="8,0,0,0" Click="Settings_Click" Padding="16,4"
              Style="{DynamicResource TileButton}" Height="34" FontSize="13"/>
    </StackPanel>

    <!-- Folder sheet -->
    <Border x:Name="FolderSheet" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
            Background="{DynamicResource ScrimBrush}" CornerRadius="12" Padding="24"
            HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="520">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="FolderTitle" Text="" FontSize="20"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <Button Content="Close" Margin="24,0,0,0" Click="FolderClose_Click"
                  Padding="16,4" Style="{DynamicResource TileButton}" Height="34" FontSize="13"/>
        </StackPanel>
        <ScrollViewer MaxHeight="480" Margin="0,16,0,0">
          <ItemsControl x:Name="FolderGrid" ItemTemplate="{StaticResource TileTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid x:Name="FolderUniform" Columns="5"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
