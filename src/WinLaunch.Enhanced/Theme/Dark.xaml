<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark glass theme. Contrast pairs measured with the WCAG checker, see DESIGN.md. -->
  <Color x:Key="ScrimColor">#0B0F14</Color>
  <Color x:Key="TileColor">#1A222C</Color>
  <Color x:Key="TileHoverColor">#232F3B</Color>
  <Color x:Key="TextColor">#FFFFFF</Color>
  <Color x:Key="MutedColor">#9AA7B4</Color>
  <Color x:Key="AccentColor">#14B8A6</Color>
  <Color x:Key="AccentInkColor">#0B0F14</Color>
  <Color x:Key="WarnColor">#EA580C</Color>

  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" Opacity="0.82"/>
  <SolidColorBrush x:Key="TileBrush" Color="{StaticResource TileColor}"/>
  <SolidColorBrush x:Key="TileHoverBrush" Color="{StaticResource TileHoverColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>

  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource TileBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource TileHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource TileBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="15"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
