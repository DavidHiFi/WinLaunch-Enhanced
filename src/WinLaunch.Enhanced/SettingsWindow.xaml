<Window x:Class="WinLaunch.Enhanced.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLaunch Enhanced settings" Icon="pack://application:,,,/WinLaunchEnhanced;component/Assets/WinLaunchEnhanced.ico"
        Width="900" Height="640" MinWidth="760" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- Transparent window so the card can have rounded corners and a soft
       shadow; the 14 px margin is the shadow's room. -->
  <Border Margin="14" CornerRadius="14" Background="{DynamicResource SolidBgBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.4" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Background="{DynamicResource CardBrush}" CornerRadius="13,0,0,13"
              MouseLeftButtonDown="Drag_MouseDown">
        <DockPanel Margin="14,16,14,14">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
            <Image Source="pack://application:,,,/WinLaunchEnhanced;component/Assets/logo-256.png" Width="30" Height="30"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WinLaunch" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Enhanced" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersion" FontSize="11" Margin="8,0,0,0"
                     Foreground="{DynamicResource MutedBrush}"/>
          <StackPanel x:Name="Nav"/>
        </DockPanel>
      </Border>

      <!-- Content -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
          <StackPanel Margin="32,22,0,10">
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" FontSize="12.5" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
          <Button Content="&#xE8BB;" Style="{DynamicResource CaptionButton}" ToolTip="Close"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"/>
        </Grid>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="32,6,26,28" Focusable="False">
          <StackPanel x:Name="PageHost"/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
