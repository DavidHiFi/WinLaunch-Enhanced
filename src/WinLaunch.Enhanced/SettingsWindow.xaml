<Window x:Class="WinLaunch.Enhanced.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLaunch Enhanced Settings" Width="500" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SolidBgBrush}" Foreground="{DynamicResource TextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

      <Border Style="{DynamicResource CardPanel}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Grid" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
          <UniformGrid Columns="2" Rows="4">
            <TextBlock Text="Columns" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="ColumnsBox" Width="80" HorizontalAlignment="Left"
                     Style="{DynamicResource SearchBox}" FontSize="13" Padding="10,6"/>
            <TextBlock Text="Rows" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="RowsBox" Width="80" HorizontalAlignment="Left"
                     Style="{DynamicResource SearchBox}" FontSize="13" Padding="10,6"/>
            <TextBlock Text="Folder columns" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="FolderColumnsBox" Width="80" HorizontalAlignment="Left"
                     Style="{DynamicResource SearchBox}" FontSize="13" Padding="10,6"/>
            <TextBlock Text="Folder rows" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="FolderRowsBox" Width="80" HorizontalAlignment="Left"
                     Style="{DynamicResource SearchBox}" FontSize="13" Padding="10,6"/>
          </UniformGrid>
          <CheckBox x:Name="SearchBarBox" Content="Show search bar" Margin="0,12,0,0"
                    Foreground="{DynamicResource TextBrush}"/>
          <CheckBox x:Name="PageDotsBox" Content="Show page indicators" Margin="0,8,0,0"
                    Foreground="{DynamicResource TextBrush}"/>
          <CheckBox x:Name="SortAlphaBox" Content="Sort items alphabetically" Margin="0,8,0,0"
                    Foreground="{DynamicResource TextBrush}"/>
          <CheckBox x:Name="SortFoldersBox" Content="Sort folders first" Margin="0,8,0,0"
                    Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource CardPanel}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Window" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
          <CheckBox x:Name="FillScreenBox" Content="Fill entire screen (not just work area)"
                    Foreground="{DynamicResource TextBrush}"/>
          <CheckBox x:Name="ActiveDesktopBox" Content="Open on the screen with the mouse"
                    Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Screen index" Style="{DynamicResource FieldLabel}" Margin="0,0,12,0"/>
            <TextBox x:Name="ScreenBox" Width="60" Style="{DynamicResource SearchBox}"
                     FontSize="13" Padding="10,6"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource CardPanel}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Hotkey" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
          <CheckBox x:Name="HotkeyOnBox" Content="Hotkey enabled"
                    Foreground="{DynamicResource TextBrush}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox x:Name="CtrlBox" Content="Ctrl" Margin="0,0,12,0"
                      Foreground="{DynamicResource TextBrush}"/>
            <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,12,0"
                      Foreground="{DynamicResource TextBrush}"/>
            <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,12,0"
                      Foreground="{DynamicResource TextBrush}"/>
            <CheckBox x:Name="WinBox" Content="Win"
                      Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Key" Style="{DynamicResource FieldLabel}" Margin="0,0,12,0"/>
            <TextBox x:Name="HotKeyBox" Width="140" Style="{DynamicResource SearchBox}"
                     FontSize="13" Padding="10,6"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource CardPanel}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
          <TextBlock Text="Theme" Style="{DynamicResource FieldLabel}" Margin="0,0,0,6"/>
          <ComboBox x:Name="ThemeCombo" Style="{DynamicResource ThemeCombo}"/>
          <TextBlock Text="Background" Style="{DynamicResource FieldLabel}" Margin="0,12,0,6"/>
          <ComboBox x:Name="BackdropCombo" Style="{DynamicResource ThemeCombo}"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Save" Width="110" Height="38" IsDefault="True"
                Click="Save_Click" Margin="0,0,8,0"
                Style="{DynamicResource PrimaryButton}"/>
        <Button Content="Data folder" Width="110" Height="38" Click="Data_Click"
                Margin="0,0,8,0" Style="{DynamicResource SecondaryButton}" FontSize="13"/>
        <Button Content="Backup now" Width="110" Height="38" Click="Backup_Click"
                Style="{DynamicResource SecondaryButton}" FontSize="13"/>
      </StackPanel>
      <Button Content="Exit WinLaunch" Width="150" Height="34" HorizontalAlignment="Left"
              Margin="0,12,0,0" Click="Exit_Click" FontSize="13"
              Style="{DynamicResource SecondaryButton}"/>
      <TextBlock x:Name="VersionText" Margin="0,16,0,8" FontSize="12"
                 Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Window>
