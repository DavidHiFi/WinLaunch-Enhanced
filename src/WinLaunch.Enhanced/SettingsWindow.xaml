<Window x:Class="WinLaunch.Enhanced.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLaunch Enhanced Settings" Width="460" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ScrimBrush}" Foreground="{DynamicResource TextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" x:Name="Form">
      <TextBlock Text="Grid" FontSize="16" Margin="0,0,0,8"/>
      <UniformGrid Columns="2" Rows="4" Margin="0,0,0,8">
        <TextBlock Text="Columns" VerticalAlignment="Center"/>
        <TextBox x:Name="ColumnsBox" Width="80" HorizontalAlignment="Left"/>
        <TextBlock Text="Rows" VerticalAlignment="Center"/>
        <TextBox x:Name="RowsBox" Width="80" HorizontalAlignment="Left"/>
        <TextBlock Text="Folder columns" VerticalAlignment="Center"/>
        <TextBox x:Name="FolderColumnsBox" Width="80" HorizontalAlignment="Left"/>
        <TextBlock Text="Folder rows" VerticalAlignment="Center"/>
        <TextBox x:Name="FolderRowsBox" Width="80" HorizontalAlignment="Left"/>
      </UniformGrid>
      <CheckBox x:Name="SearchBarBox" Content="Show search bar" Margin="0,4"/>
      <CheckBox x:Name="PageDotsBox" Content="Show page indicators" Margin="0,4"/>
      <CheckBox x:Name="SortAlphaBox" Content="Sort items alphabetically" Margin="0,4"/>
      <CheckBox x:Name="SortFoldersBox" Content="Sort folders first" Margin="0,4"/>

      <TextBlock Text="Window" FontSize="16" Margin="0,16,0,8"/>
      <CheckBox x:Name="FillScreenBox" Content="Fill entire screen (not just work area)" Margin="0,4"/>
      <CheckBox x:Name="ActiveDesktopBox" Content="Open on the screen with the mouse" Margin="0,4"/>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="Screen index" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="ScreenBox" Width="60"/>
      </StackPanel>

      <TextBlock Text="Hotkey" FontSize="16" Margin="0,16,0,8"/>
      <CheckBox x:Name="HotkeyOnBox" Content="Hotkey enabled" Margin="0,4"/>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <CheckBox x:Name="CtrlBox" Content="Ctrl" Margin="0,0,12,0"/>
        <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,12,0"/>
        <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,12,0"/>
        <CheckBox x:Name="WinBox" Content="Win" Margin="0,0,12,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="Key" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="HotKeyBox" Width="120"/>
      </StackPanel>

      <TextBlock Text="Theme" FontSize="16" Margin="0,16,0,8"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="DarkRadio" Content="Dark glass" Margin="0,0,16,0"/>
        <RadioButton x:Name="LightRadio" Content="Light"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <Button Content="Save" Width="100" IsDefault="True" Click="Save_Click" Margin="0,0,8,0"/>
        <Button Content="Data folder" Width="100" Click="Data_Click" Margin="0,0,8,0"/>
        <Button Content="Backup now" Width="100" Click="Backup_Click"/>
      </StackPanel>
      <Button Content="Exit WinLaunch" Width="140" HorizontalAlignment="Left"
              Margin="0,12,0,0" Click="Exit_Click"/>
      <TextBlock x:Name="VersionText" Margin="0,16,0,0"
                 Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
  </ScrollViewer>
</Window>
